# Copy to .env for local development. Never commit .env.
# For production (Cloud Run), set these as environment variables in the service config.

# Flask secret key — generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=your-secret-key-here

# Google Maps Embed API key — restrict to Maps Embed API + your domain in GCP Console
MAPS_API_KEY=your-maps-api-key-here

# Set to "true" only for local development, never in production
FLASK_DEBUG=false

# Port (Cloud Run sets this automatically)
PORT=8080
